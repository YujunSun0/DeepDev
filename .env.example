# ===========================================
# DeepDev 환경 변수 (복사 후 .env로 저장)
# .env는 절대 git에 커밋하지 마세요.
# ===========================================

# Database (프로덕션: Railway/Neon 등 연결 문자열)
DATABASE_URL="postgresql://deepdev:deepdev@localhost:5433/deepdev?schema=public"

# Redis (선택, v1에서 미사용)
REDIS_URL="redis://localhost:6379"

# JWT (프로덕션: 32자 이상 강력한 랜덤 문자열 사용)
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# App
API_PORT=4000
# Web 앱 API URL (프로덕션: https://your-api.railway.app)
NEXT_PUBLIC_API_URL="http://localhost:4000"
# 사이트 URL (SEO, sitemap, og:url) (프로덕션: https://your-domain.com)
NEXT_PUBLIC_SITE_URL="https://deepdev.info"

# OAuth 소셜 로그인 (Google Cloud Console, GitHub Developer settings에서 앱 생성)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"
# OAuth 콜백 후 리다이렉트할 프론트엔드 URL (미설정 시 SITE_URL 사용)
FRONTEND_URL="http://localhost:3000"

# CORS (프로덕션: 웹 도메인, 쉼표로 복수 허용)
# 예: CORS_ORIGIN="https://deepdev.kr,https://www.deepdev.kr"
CORS_ORIGIN="http://localhost:3000"

# Rate limiting (API, 분당 요청 제한)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Paddle (결제, API 서버에서 읽음)
# Sandbox: sandbox-vendors.paddle.com / Live: vendors.paddle.com → Developer tools → Authentication
# API 키 (pdl_sdbx_... = sandbox, pdl_live_... = live). 서버 전용, 절대 공개 금지
PADDLE_API_KEY=""
# Client-side token (test_... / live_...). 브라우저에 공개되는 값이며 /api/billing/status로 전달됨
PADDLE_CLIENT_SIDE_TOKEN=""
# Notifications(webhook) 설정의 secret key (pdl_ntfset_...)
PADDLE_WEBHOOK_SECRET=""
# Pro 월간 가격 ID (pri_...). sandbox와 live는 ID가 다름
PADDLE_PRO_PRICE_ID=""
# 선택: sandbox | production (비우면 API 키 접두사로 자동 판단)
PADDLE_ENV=""
# 결제 심사 중/테스트 전용일 때 false로 설정 → Pro 업그레이드 버튼이 "준비 중"으로 표시됨
BILLING_CHECKOUT_ENABLED="true"
# 웹 앱(Vercel 등) 배포 시: NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false 로 설정하면 API 없이도 UI에서 준비중 표시
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED="true"

# 이메일 인증 (Resend, 무료 3,000통/월)
RESEND_API_KEY=""
# 발신 이메일 (Resend 도메인 인증 후 사용, 예: noreply@yourdomain.com)
EMAIL_FROM="DeepDev <onboarding@resend.dev>"
# 인증 링크에 사용할 웹 URL (API에서 필요)
SITE_URL="http://localhost:3000"

# Sentry (모니터링, 프로덕션 DSN 설정)
SENTRY_DSN=""
# 프론트엔드용 (브라우저에서 공개되므로 별도 프로젝트 권장)
NEXT_PUBLIC_SENTRY_DSN=""
