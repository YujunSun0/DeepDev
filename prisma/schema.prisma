generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  FREE
  PRO
  MASTER
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?  @map("password_hash")   // Optional: OAuth 사용자는 null
  name               String?
  avatarUrl          String?  @map("avatar_url")      // OAuth 프로필 이미지
  authProvider       String?  @map("auth_provider")    // "email" | "google" | "github"
  authProviderId     String?  @map("auth_provider_id") // OAuth provider의 고유 ID
  emailVerified      Boolean  @default(false) @map("email_verified")
  planType           PlanType @default(FREE) @map("plan_type")
  preferredLanguage String?  @map("preferred_language") @db.VarChar(32)
  paddleCustomerId     String?   @map("paddle_customer_id")     // ctm_...
  paddleSubscriptionId String?   @map("paddle_subscription_id") // sub_... (현재 구독)
  /// 마지막으로 반영한 구독 webhook의 occurred_at. 순서가 뒤바뀐 이벤트를 무시하는 데 사용
  paddleEventAt        DateTime? @map("paddle_event_at")
  subscriptionStatus String?  @map("subscription_status")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  sessions         Session[]
  masteries        UserMastery[]
  explorations     Exploration[]
  userAchievements UserAchievement[]
  dailyAttendances UserDailyAttendance[]

  @@index([authProvider, authProviderId])
  @@index([paddleCustomerId])
  @@index([paddleSubscriptionId])
  @@map("users")
}

model Concept {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String
  level           Int
  domain          String   @default("javascript") @db.VarChar(32)
  prerequisiteIds Json     @default("[]") @map("prerequisite_ids")
  masteryWeight   Float    @default(1.0) @map("mastery_weight")
  createdAt       DateTime @default(now()) @map("created_at")

  sessions     Session[]
  masteries    UserMastery[]
  explorations Exploration[]

  @@map("concepts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  conceptId String   @map("concept_id")
  level     Int
  state     String   @default("INIT")
  tokenUsed Int      @default(0) @map("token_used")
  score     Float?
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  concept Concept @relation(fields: [conceptId], references: [id])

  @@map("sessions")
}

model UserMastery {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  conceptId    String   @map("concept_id")
  masteryScore Float    @default(0) @map("mastery_score")
  attemptCount Int      @default(0) @map("attempt_count")
  lastUpdated  DateTime @default(now()) @map("last_updated")

  user    User    @relation(fields: [userId], references: [id])
  concept Concept @relation(fields: [conceptId], references: [id])

  @@unique([userId, conceptId])
  @@map("user_masteries")
}

model Exploration {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  conceptId String   @map("concept_id")
  title     String   @default("")
  messages  Json     @default("[]")
  tokenUsed Int      @default(0) @map("token_used")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  concept Concept @relation(fields: [conceptId], references: [id])

  @@map("explorations")
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  icon        String?  // 아이콘 경로 또는 emoji
  category    String   @default("award") @db.VarChar(16) // "record" | "award"
  targetValue Int      @default(0) @map("target_value")
  tier        Int?     // Awards용 단계 (1~10)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  value         Int      @default(0) // 달성 시점 값
  achievedAt    DateTime @default(now()) @map("achieved_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model UserDailyAttendance {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date @map("date")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("user_daily_attendances")
}

/// Paddle webhook 중복 처리 방지 (재전송 시 같은 event_id로 옴)
model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique @map("event_id")   // evt_...
  eventType String   @map("event_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webhook_events")
}
